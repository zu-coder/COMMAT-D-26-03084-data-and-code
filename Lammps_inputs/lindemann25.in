units metal 
boundary p p p
atom_style atomic
timestep 0.001

#Get Pt nanoparticles
variable A0 equal 2.86
lattice bcc ${A0}
region mybox block -15 15 -15 15 -15 15
create_box 2 mybox
region pt_nano sphere 0 0 0 25 units box 
create_atoms 1 region pt_nano

set type 1 type/ratio 2 0.0579 6372347

#Using eam potential
pair_style      meam
pair_coeff      * * Jelinek_2012_meamf Al Si Mg Cu Fe Jelinek_2012_meam.alsimgcufe Fe Si 

variable j loop 0 68
label loop_T
variable temperature equal 300+25*$j
fix 1 all nvt temp ${temperature} ${temperature} 0.1
run 20000
unfix 1 

#Output
thermo 100
thermo_style custom step pe temp etotal press lx ly lz vol
thermo_modify flush yes 
dump 1 all atom 1000 melt_${temperature}.atom

fix 1 all nvt temp ${temperature} ${temperature} 0.1
run 10000
unfix 1
undump 1
next j
jump SELF loop_T