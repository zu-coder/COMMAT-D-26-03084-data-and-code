units metal
dimension 3 
boundary p p p 
atom_style atomic 
neighbor 3 bin 
neigh_modify every 1 delay 0 check yes
timestep 0.001 

pair_style meam 
lattice bcc 2.87

# ================= 1. 建立无真空层的满盒子 =================
region box block -8 8 -8 8 -8 8 
create_box 2 box 
create_atoms 1 box 

# 精确比例替换 
set type 1 type/ratio 2 0.0579 6541 

pair_coeff      * * Jelinek_2012_meamf Al Si Mg Cu Fe Jelinek_2012_meam.alsimgcufe Fe Si 

mass 1 55.85
mass 2 28.09

write_data initial.data 

variable T equal 1825

thermo 100
thermo_style custom step temp press density
thermo_modify flush yes 
dump 1 all atom 100 1.xyz
# ================= 2. 核心修改：极高温熔解 + 淬火降温 (NPT) =================
# 赋予 2800K 极高温初速度，强行克服完美晶格的过热效应
velocity all create 2800 4358978 rot yes mom yes dist gaussian loop local

# 第一步：2800K 下恒压熔化 (50ps)，确保彻底失去晶体结构变成熔体
fix 1 all npt temp 2800 2800 0.1 iso 0.0 0.0 1.0
run 50000 
unfix 1

# 第二步：将这团纯净的液态金属平稳降温至目标温度 $T (50ps)
fix 2 all npt temp 2800 $T 0.1 iso 0.0 0.0 1.0
run 50000
unfix 2

# 第三步：在目标温度 $T 下彻底平衡密度和体积 (50ps)
fix 3 all npt temp $T $T 0.1 iso 0.0 0.0 1.0
run 50000
unfix 3
undump 1 

# ================= 3. 拉伸 Z 轴，暴露真实表面 =================
# 将 Z 轴瞬间放大 3 倍，上下形成足够的真空区
change_box all z scale 3.0

# ================= 4. NVT 悬浮液膜弛豫与测量 =================
# 切换为 NVT 系综，液膜表面原子开始自发重组收缩
fix 4 all nvt temp $T $T 0.1 

dump 1 all custom 1000 dump_$T.lammpstrj id type x y z
run 200000  # 充分弛豫，让 Pxx/Pyy/Pzz 趋于稳定
undump 1

reset_timestep 0 

# ================= 5. 计算表面张力 =================
# 1 bar*A = 10^-5 N/m，乘以 0.01 直接转化为 mN/m
variable gamma equal 0.5*lz*(pzz-0.5*(pxx+pyy))*0.01

fix 11 all ave/time 1 100 100 v_gamma ave running start 100 

# 注意：这里必须在 thermo_style 中加入 press pxx pyy pzz，防止变量提取报错
thermo 100
thermo_style custom step temp press pxx pyy pzz v_gamma f_11
thermo_modify flush yes
run 500000